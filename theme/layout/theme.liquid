<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    <meta name="theme-color" content="{{ settings.color_ivory }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {% render 'css-variables' %}
    {% render 'fonts' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {%- comment -%} テーマエディタではセクションが差し替わるので、フェードインを使わず最初から見せる {%- endcomment -%}
    {%- unless request.design_mode -%}
      <script>document.documentElement.className += " js";</script>
    {%- endunless -%}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
