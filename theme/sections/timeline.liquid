{% comment %}
  日程つきの流れ（Elieca の「採寸から出来上がるまで」）。ステップはブロックで、各ステップに時期の目安と
  細かい内容（1行に1つ）を持てる。
{% endcomment %}
{%- assign title_id = 'timeline-title-' | append: section.id -%}
<section class="chapter full-width {% if section.settings.tinted %}chapter-tinted{% endif %}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %} aria-labelledby="{{ title_id }}">
  {% render 'chapter-head', settings: section.settings, title_id: title_id %}
  <ol class="timeline">
    {%- for block in section.blocks -%}
      {%- assign details = block.settings.details | newline_to_br | split: '<br />' -%}
      <li class="timeline-step reveal" {{ block.shopify_attributes }}>
        <p class="timeline-when">{{ block.settings.when }}</p>
        <div class="timeline-body">
          <h3 class="timeline-title"><span class="timeline-no" aria-hidden="true">{{ forloop.index }}</span>{{ block.settings.title }}</h3>
          {%- if block.settings.details != blank -%}
            <ul class="timeline-details">
              {%- for item in details -%}{%- assign item = item | strip -%}{%- if item != blank -%}<li>{{ item }}</li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ol>
  {%- if section.settings.note != blank -%}<p class="timeline-note reveal">{{ section.settings.note }}</p>{%- endif -%}
</section>

{% stylesheet %}
  .timeline { max-width: var(--w-narrow); margin: 0 auto; border-top: 1px solid var(--line); }
  .timeline-step {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0 1.4rem;
    padding: 1.2rem 0.2rem;
    border-bottom: 1px solid var(--line);
  }
  .timeline-when { font: italic 400 1rem/1.8 var(--font-en); color: var(--gold-ink); font-variant-numeric: lining-nums; }
  .timeline-title { display: flex; align-items: baseline; gap: 0.7em; font: 500 1rem/1.8 var(--font-jp); font-variant-numeric: lining-nums; }
  .timeline-no {
    flex: none;
    display: inline-grid; place-items: center;
    width: 1.8em; height: 1.8em;
    border: 1px solid var(--gold);
    border-radius: 50%;
    font: italic 400 0.85rem/1 var(--font-en); font-variant-numeric: lining-nums;
    color: var(--gold-ink);
  }
  .timeline-details { margin-top: 0.4rem; padding-left: 2.5em; }
  .timeline-details li { position: relative; font-size: 0.86rem; line-height: 1.9; color: var(--muted); }
  .timeline-details li::before { content: "—"; position: absolute; left: -1.3em; color: var(--gold); }
  .timeline-note { max-width: var(--w-narrow); margin: 1.4rem auto 0; font-size: 0.82rem; color: var(--muted); }
  @media (max-width: 559px) {
    .timeline-step { grid-template-columns: 1fr; }
    .timeline-when { font-size: 0.9rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.timeline",
  "class": "section-timeline",
  "settings": [
    { "type": "text", "id": "chapter_no", "label": "t:labels.chapter_no" },
    { "type": "text", "id": "label", "label": "t:labels.chapter_label", "default": "Process" },
    { "type": "text", "id": "title", "label": "t:labels.heading", "default": "採寸から出来上がるまで" },
    { "type": "textarea", "id": "lede", "label": "t:labels.lede" },
    { "type": "textarea", "id": "note", "label": "t:labels.note" },
    { "type": "checkbox", "id": "tinted", "label": "t:labels.tinted", "default": false },
    { "type": "text", "id": "anchor", "label": "t:labels.anchor", "info": "t:info.anchor" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:blocks.step",
      "settings": [
        { "type": "text", "id": "when", "label": "t:labels.when", "default": "1月" },
        { "type": "text", "id": "title", "label": "t:labels.heading", "default": "ヒアリング" },
        { "type": "textarea", "id": "details", "label": "t:labels.list_items", "info": "t:info.one_per_line" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.timeline" }]
}
{% endschema %}
