{% comment %}
  入口（2026-09-29 打ち合わせ「入口をわかりやすく」）。ウエディング・カラー・セミオーダー（Elieca）・
  メンズ・マザードレス・業者さま（with a WISH）など、行き先をカードで並べる。
  B2B の案内（提携すれば持ち込める）は下の「補足」に書く。
{% endcomment %}
{%- assign title_id = 'entrances-title-' | append: section.id -%}
<section class="chapter full-width {% if section.settings.tinted %}chapter-tinted{% endif %}" id="{{ section.settings.anchor | default: 'entrances' }}" aria-labelledby="{{ title_id }}">
  {% render 'chapter-head', settings: section.settings, title_id: title_id %}
  <ul class="entrance-grid">
    {%- for block in section.blocks -%}
      <li class="entrance reveal{% if block.settings.partner %} entrance-partner{% endif %}" {{ block.shopify_attributes }}>
        <a class="entrance-link" href="{{ block.settings.link | default: '#' }}">
          <figure class="entrance-frame">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 720 | image_tag: widths: '360, 540, 720', sizes: '(max-width: 559px) 46vw, (max-width: 919px) 30vw, 340px', loading: 'lazy', alt: '' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'entrance-placeholder' }}
            {%- endif -%}
          </figure>
          <span class="entrance-body">
            {%- if block.settings.en != blank -%}<span class="entrance-en" translate="no">{{ block.settings.en }}</span>{%- endif -%}
            <span class="entrance-title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}<span class="entrance-text">{{ block.settings.text }}</span>{%- endif -%}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
  {%- if section.settings.note != blank -%}
    <div class="entrance-note reveal">{{ section.settings.note }}</div>
  {%- endif -%}
</section>

{% stylesheet %}
  .entrance-grid {
    max-width: var(--w-wide);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem 0.8rem;
  }
  @media (min-width: 920px) { .entrance-grid { grid-template-columns: repeat(3, 1fr); gap: 2.4rem 2rem; } }
  .entrance-link { display: block; color: inherit; text-decoration: none; text-align: center; }
  .entrance-frame {
    padding: 8px;
    border: 1px solid var(--line);
    background: var(--paper);
    transition: border-color var(--duration-fast) ease-out;
  }
  .entrance-frame img, .entrance-frame .entrance-placeholder { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .entrance-frame .entrance-placeholder { background: var(--greige); fill: var(--line); }
  .entrance-link:hover .entrance-frame, .entrance-link:focus-visible .entrance-frame { border-color: var(--gold); }
  .entrance-body { display: block; margin-top: 0.9rem; }
  .entrance-en { display: block; font: italic 400 0.9rem/1.4 var(--font-en); font-variant-numeric: lining-nums; color: var(--gold-ink); letter-spacing: 0.06em; }
  .entrance-title { display: block; margin-top: 0.2rem; font: 500 1.02rem/1.6 var(--font-jp); font-variant-numeric: lining-nums; transition: color var(--duration-fast) ease-out; }
  .entrance-link:hover .entrance-title { color: var(--gold-ink); }
  .entrance-text { display: block; margin-top: 0.35rem; font-size: 0.8rem; line-height: 1.8; color: var(--muted); }
  /* 業者さま向けは墨地で、一般のお客さま向けと見分けがつくように */
  .entrance-partner .entrance-frame { background: var(--ink); border-color: var(--ink); }
  .entrance-partner .entrance-link:hover .entrance-frame { border-color: var(--gold); }
  .entrance-note {
    max-width: var(--w-narrow);
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--gold);
    background: var(--paper);
    font-size: 0.88rem;
    line-height: 1.95;
    text-align: center;
  }
  .entrance-note a { color: var(--gold-ink); }
  @media (max-width: 559px) {
    .entrance-frame { padding: 5px; }
    .entrance-title { font-size: 0.92rem; }
    .entrance-text { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.entrances",
  "class": "section-entrances",
  "settings": [
    { "type": "text", "id": "chapter_no", "label": "t:labels.chapter_no" },
    { "type": "text", "id": "label", "label": "t:labels.chapter_label", "default": "Find Your Style" },
    { "type": "text", "id": "title", "label": "t:labels.heading", "default": "お探しの一着へ" },
    { "type": "textarea", "id": "lede", "label": "t:labels.lede" },
    { "type": "richtext", "id": "note", "label": "t:labels.entrance_note", "info": "t:info.entrance_note" },
    { "type": "checkbox", "id": "tinted", "label": "t:labels.tinted", "default": false },
    { "type": "text", "id": "anchor", "label": "t:labels.anchor", "info": "t:info.anchor", "default": "entrances" }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "t:blocks.entry",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:labels.image" },
        { "type": "text", "id": "en", "label": "t:labels.eyebrow" },
        { "type": "text", "id": "title", "label": "t:labels.heading", "default": "ウエディングドレス" },
        { "type": "textarea", "id": "text", "label": "t:labels.description" },
        { "type": "url", "id": "link", "label": "t:labels.link" },
        { "type": "checkbox", "id": "partner", "label": "t:labels.partner_entry", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.entrances" }]
}
{% endschema %}
